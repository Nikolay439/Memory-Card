main_line.setSpacing(5)

main_win.setLayout(main_line)

answers = [btn_answer1 , btn_answer2 , btn_answer3 , btn_answer4]


class Questions():
    def __init__(self , question , right_answer, wrong1 , wrong2 ,  wrong3):
        self.question = question
        self.right_answer = right_answer
        self.wrong1 = wrong1
        self.wrong2 = wrong2
        self.wrong3 = wrong3

question_list = []
question_list.append(Questions("Государственный язык Бразилии?" ,"Португальский" , "Испанский" , "Русский","Итальянский"))
question_list.append(Questions("Кто написал роман 1984 ?" ,"Джордж Оруэлл", "Олдос Хаксли", "Федор Достоевский", "Лев Толстой"))
question_list.append(Questions("В каком году была основана Москва?" ,"1147", "1240", "1215", "1492"))
question_list.append(Questions("Какой планетой является красная планета?" ,"Марс", "Венера", "Юпитер", "Сатурн"))
question_list.append(Questions("Какой цвет получается при смешивании красного и синего?" ,"Фиолетовый", "Зеленый", "Оранжевый", "Желтый"))
question_list.append(Questions("Какой элемент обозначается символ О в периодической таблице?" ,"Кислород", "Углерод", "Азот", "Гелий"))

shuffle(question_list)



#кнопка ответ
def ask (q:Questions):
    shuffle(answers)
    lb_Question.setText(q.question)
    answers[0].setText(q.right_answer)
    answers[1].setText(q.wrong1)
    answers[2].setText(q.wrong2)
    answers[3].setText(q.wrong3)
    ansInformText.setText(q.right_answer)
    show_question()

main_win.cur_question = -1
def next_question():
    main_win.cur_question += 1
    if main_win.cur_question == 5:
        main_win.cur_question = 0
    ask(question_list[main_win.cur_question])

    


def check_answer():
    main_win.total_questions += 1
    if answers[0].isChecked():
        ans_MainText.setText("Правильно!")
        main_win.correct += 1
        show_result()
    else:
        if answers[1].isChecked() or answers[2].isChecked() or answers[3].isChecked():
            ans_MainText.setText("Неправильно!")
            #uncorrect += 1
            show_result()
    if  main_win.total_questions == 6:
        print("Статистика:")
        print("Всего вопросов" , main_win.total_questions)
        print("Правильных ответов" , main_win.correct)
        print("Рейтинг" ,  main_win.correct/ main_win.total_questions * 100)




def show_result():
    radioGroupBox.hide()
    ansGroupBox.show()
    button.setText("Следующий вопрос")

def show_question():
    radioGroupBox.show()
    ansGroupBox.hide()
    button.setText("Ответить")

    RadioGroup.setExclusive(False)
    btn_answer1.setChecked(False)
    btn_answer2.setChecked(False)
    btn_answer3.setChecked(False)
    btn_answer4.setChecked(False)
    RadioGroup.setExclusive(True)
    
        

def text_button():
    if button.text() == "Ответить":
        check_answer()
    else:
        next_question()
   
        


button.clicked.connect(text_button)
next_question()
radioGroupBox.show()
ansGroupBox.hide()
main_win.show()
app.exec_()
